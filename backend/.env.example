# IHURIRO API server
PORT=4000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# XAMPP MySQL (start MySQL in the XAMPP control panel first).
# The API creates this database and all tables on startup.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=ihuriro_app

# Set to 1 only when running behind a trusted reverse proxy
# TRUST_PROXY=1

# Optional: enables "Continue with Google" on the login and signup screen.
# 1. In Google Cloud Console, configure the OAuth consent screen.
# 2. Create an OAuth 2.0 Client ID of type "Web application".
# 3. Add http://localhost:5173 and http://127.0.0.1:5173 (plus your production
#    origin) to "Authorized JavaScript origins". No redirect URI is needed.
# 4. Paste the client ID below and restart the API.
# The Google button only appears once this value is set.
GOOGLE_CLIENT_ID=

# Optional: enables full AI answers through Anthropic.
# Without it the assistant falls back to the built-in knowledge base.
ANTHROPIC_API_KEY=
AI_MODEL=claude-3-5-sonnet-20241022
AI_TIMEOUT_MS=20000
